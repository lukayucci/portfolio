---
interface Props {
  eyebrow: string;
  location: string;
  role: string;
  tagline: string;
  scroll: string;
  asideTop: string;
  asideBottom: string;
}

const { eyebrow, location, role, tagline, scroll, asideTop, asideBottom } = Astro.props;
const frames = Array.from({ length: 8 });
---

<section class="hero" id="hero" data-hero aria-label="Luka García Yucci">
  <div class="hero__sticky">
    <div class="hero__bg" aria-hidden="true"></div>

    <div class="hero__scene" data-hero-scene aria-hidden="true">
      <div class="hero__core"></div>
      <div class="hero__tunnel">
        {frames.map((_, i) => (
          <div class="tunnel__frame" style={`--i:${i}; --z:${(i + 1) * -112}px`}>
            <span class="tunnel__index mono">{String(i + 1).padStart(2, '0')}</span>
          </div>
        ))}
      </div>
    </div>

    <canvas class="hero__field" data-hero-field aria-hidden="true"></canvas>

    <div class="hero__content">
      <div class="hero__top">
        <p class="hero__eyebrow mono">
          <i class="hero__dot" aria-hidden="true"></i>
          {eyebrow}
          <span class="hero__slash" aria-hidden="true">/</span>
          {location}
        </p>
        <p class="hero__aside mono">
          <span>{asideTop}</span>
          <span>{asideBottom}</span>
        </p>
      </div>

      <h1 class="hero__title" aria-label="Luka García Yucci">
        <span class="hero__line"><span class="hero__word">Luka</span></span>
        <span class="hero__line"><span class="hero__word">García</span></span>
        <span class="hero__line hero__line--outline"
          ><span class="hero__word">Yucci<i class="hero__accent">.</i></span></span
        >
      </h1>

      <div class="hero__foot">
        <div class="hero__role-wrap">
          <p class="hero__role">{role}</p>
          <p class="hero__tagline">{tagline}</p>
        </div>
        <div class="hero__cue mono" aria-hidden="true">
          <span>{scroll}</span>
          <i></i>
        </div>
      </div>
    </div>

    <div class="hero__progress" aria-hidden="true"><span></span></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 150vh;
    background: var(--bg);
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: radial-gradient(120% 90% at 50% 42%, #101216 0%, #08090b 64%);
    perspective: 1500px;
    perspective-origin: 50% 42%;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: clamp(48px, 7vw, 96px) clamp(48px, 7vw, 96px);
    opacity: 0.14;
    -webkit-mask-image: radial-gradient(70% 62% at 50% 44%, #000 0%, transparent 76%);
    mask-image: radial-gradient(70% 62% at 50% 44%, #000 0%, transparent 76%);
  }

  .hero__scene {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--p, 0) * 360px))
      rotateX(calc((var(--my, 0) * 2.5deg) + (var(--p, 0) * 8deg)))
      rotateY(calc(var(--mx, 0) * 3.5deg));
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
    will-change: transform, opacity;
  }

  .hero.is-ready .hero__scene {
    opacity: 1;
  }

  .hero__field {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity 0.55s var(--ease-out);
  }

  .hero.is-field .hero__field {
    opacity: clamp(0, calc(1 - (var(--p, 0) - 0.52) * 2.2), 1);
  }

  .hero__core {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 46vw;
    height: 46vw;
    max-width: 640px;
    max-height: 640px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 66%);
    filter: blur(40px);
    opacity: 0.4;
  }

  .hero__tunnel {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    opacity: clamp(0, calc(1 - (var(--p, 0) - 0.72) * 3.2), 1);
  }

  .tunnel__frame {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(64vw, 820px);
    height: min(46vw, 460px);
    border: 1px solid var(--line);
    transform: translate3d(-50%, -50%, calc(var(--z) + var(--p, 0) * 980px))
      rotateZ(calc(var(--i) * 0.9deg));
    opacity: calc(1 - var(--i) * 0.1);
    transform-style: preserve-3d;
  }

  .tunnel__frame::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(242, 240, 233, 0.045);
  }

  .tunnel__frame:nth-child(1) {
    border-color: rgba(214, 255, 63, 0.28);
  }

  .tunnel__index {
    position: absolute;
    top: -0.45rem;
    left: 0.35rem;
    font-size: 0.55rem;
    color: var(--muted-2);
    background: #0b0d10;
    padding: 0 0.3rem;
  }

  .hero__content {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    padding: clamp(5.5rem, 10vh, 7.5rem) var(--gutter) clamp(1.5rem, 4vh, 2.75rem);
    transform: translateZ(60px) translateY(calc(var(--p, 0) * -34px));
    opacity: clamp(0, calc(1 - (var(--p, 0) - 0.58) * 2.4), 1);
    will-change: transform, opacity;
  }

  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    color: var(--muted);
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.9s var(--ease-out),
      transform 0.9s var(--ease-out);
  }

  .hero.is-ready .hero__top {
    opacity: 1;
    transform: none;
    transition-delay: 0.5s;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hero__slash {
    color: var(--muted-2);
    margin-inline: 0.2rem;
  }

  .hero__aside {
    display: none;
    flex-direction: column;
    gap: 0.45rem;
    text-align: right;
    color: var(--muted-2);
  }

  .hero__aside span:first-child {
    color: var(--muted);
  }

  .hero__title {
    margin-top: auto;
    font-size: clamp(3.1rem, 13.5vw, 12.5rem);
    line-height: 0.84;
    letter-spacing: -0.05em;
    font-weight: 600;
    text-transform: uppercase;
  }

  .hero__line {
    display: block;
  }

  .hero__word {
    display: block;
    opacity: 0;
    transform: translateY(0.32em);
    filter: blur(7px);
    transition:
      opacity 1s var(--ease-out),
      transform 1.15s var(--ease-out),
      filter 1s var(--ease-out);
    will-change: transform, opacity, filter;
  }

  .hero.is-ready .hero__word {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .hero.is-ready .hero__line:nth-child(2) .hero__word {
    transition-delay: 0.09s;
  }

  .hero.is-ready .hero__line:nth-child(3) .hero__word {
    transition-delay: 0.18s;
  }

  .hero__line--outline .hero__word {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line-strong);
  }

  .hero__accent {
    -webkit-text-stroke: 0;
    color: var(--accent);
    font-style: normal;
  }

  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: clamp(1.25rem, 3vh, 2.25rem);
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.9s var(--ease-out),
      transform 0.9s var(--ease-out);
  }

  .hero.is-ready .hero__foot {
    opacity: 1;
    transform: none;
    transition-delay: 0.62s;
  }

  .hero__role-wrap {
    max-width: 52ch;
  }

  .hero__role {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .hero__tagline {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    line-height: 1.55;
    max-width: 52ch;
  }

  .hero__cue {
    display: none;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
    opacity: clamp(0, calc(1 - var(--p, 0) * 6), 1);
  }

  .hero__cue i {
    display: block;
    width: 1px;
    height: 42px;
    background: linear-gradient(var(--accent), transparent);
  }

  .hero__progress {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    z-index: 6;
    height: 1px;
    background: var(--line);
  }

  .hero__progress span {
    display: block;
    height: 100%;
    width: calc(var(--p, 0) * 100%);
    background: var(--accent);
    transform-origin: left;
  }

  @media (min-width: 720px) {
    .hero__aside {
      display: flex;
    }

    .hero__cue {
      display: flex;
    }
  }

  @media (max-width: 719px) {
    .hero__foot {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero__title {
      font-size: clamp(3rem, 17.5vw, 6.5rem);
    }
  }

  @media (max-height: 760px) and (min-width: 720px) {
    .hero__title {
      font-size: clamp(2.75rem, 9.5vw, 7.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: 100svh;
    }

    .hero__content {
      opacity: 1;
      transform: none;
    }

    .hero__field {
      display: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(pointer: fine)');
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

    let progress = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const updateProgress = () => {
      const total = hero.offsetHeight - window.innerHeight;
      progress = total > 0 ? clamp(-hero.getBoundingClientRect().top / total, 0, 1) : 0;
      hero.style.setProperty('--p', progress.toFixed(4));
    };

    const onPointerMove = (event: PointerEvent) => {
      targetX = (event.clientX / window.innerWidth) * 2 - 1;
      targetY = (event.clientY / window.innerHeight) * 2 - 1;
    };

    const animate = () => {
      currentX += (targetX - currentX) * 0.06;
      currentY += (targetY - currentY) * 0.06;
      hero.style.setProperty('--mx', currentX.toFixed(4));
      hero.style.setProperty('--my', currentY.toFixed(4));
      requestAnimationFrame(animate);
    };

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      hero.classList.add('is-ready');
    };

    if (reduceMotion.matches) {
      hero.style.setProperty('--p', '0');
      hero.style.setProperty('--mx', '0');
      hero.style.setProperty('--my', '0');
      start();
    } else {
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);

      if (finePointer.matches) {
        window.addEventListener('pointermove', onPointerMove, { passive: true });
        requestAnimationFrame(animate);
      }

      updateProgress();
      requestAnimationFrame(() => requestAnimationFrame(start));
      window.setTimeout(start, 700);
    }
  }
</script>

<script>
  (() => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const sticky = hero?.querySelector<HTMLElement>('.hero__sticky');
    const canvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-field]');
    if (!hero || !sticky || !canvas) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const stickyEl = sticky;
    const canvasEl = canvas;
    const ctx = canvasEl.getContext('2d');
    if (!ctx) return;
    const surface: CanvasRenderingContext2D = ctx;

    const warpCanvas = document.createElement('canvas');
    const warpCtx = warpCanvas.getContext('2d');
    if (!warpCtx) return;
    const warpSurface: CanvasRenderingContext2D = warpCtx;

    const background = stickyEl.querySelector<HTMLElement>('.hero__bg');
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

    let width = 1;
    let height = 1;
    let grid = 72;
    let active = false;
    let running = false;
    let lastFrame = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let energy = 0;
    let energyTarget = 0;

    function readGrid() {
      const size = background ? parseFloat(getComputedStyle(background).backgroundSize) : NaN;
      grid = Number.isFinite(size) ? size : clamp(width * 0.07, 48, 96);
    }

    function resize() {
      const rect = stickyEl.getBoundingClientRect();
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      readGrid();

      canvasEl.width = Math.round(width * DPR);
      canvasEl.height = Math.round(height * DPR);
      surface.setTransform(DPR, 0, 0, DPR, 0, 0);

      warpCanvas.width = Math.round(width * DPR);
      warpCanvas.height = Math.round(height * DPR);
      warpSurface.setTransform(DPR, 0, 0, DPR, 0, 0);

      if (active) draw(performance.now());
    }

    function pointFrom(event: PointerEvent) {
      const rect = stickyEl.getBoundingClientRect();
      return { x: event.clientX - rect.left, y: event.clientY - rect.top };
    }

    function start() {
      if (running) return;
      running = true;
      lastFrame = 0;
      requestAnimationFrame(frame);
    }

    function warp(x: number, y: number, radius: number, strength: number) {
      const dx = x - currentX;
      const dy = y - currentY;
      const dist = Math.hypot(dx, dy);
      if (dist > radius || dist === 0) return { x, y };

      const falloff = 1 - dist / radius;
      const push = strength * falloff * falloff;
      const ux = dx / dist;
      const uy = dy / dist;
      const swirl = 0.22 * push;

      return {
        x: x + ux * push - uy * swirl,
        y: y + uy * push + ux * swirl,
      };
    }

    function strokeLine(context: CanvasRenderingContext2D, points: { x: number; y: number }[]) {
      context.beginPath();
      for (let i = 0; i < points.length; i++) {
        const point = points[i];
        if (i === 0) context.moveTo(point.x, point.y);
        else context.lineTo(point.x, point.y);
      }
      context.stroke();
    }

    function draw(now: number) {
      surface.clearRect(0, 0, width, height);
      if (!active) return;

      const radius = 210 + energy * 55;
      const strength = 22 + energy * 48;
      const sampleStep = 7;
      const minX = Math.max(0, currentX - radius - strength);
      const maxX = Math.min(width, currentX + radius + strength);
      const minY = Math.max(0, currentY - radius - strength);
      const maxY = Math.min(height, currentY + radius + strength);

      surface.globalCompositeOperation = 'lighter';
      const glow = surface.createRadialGradient(currentX, currentY, 0, currentX, currentY, radius);
      glow.addColorStop(0, 'rgba(214, 255, 63, 0.11)');
      glow.addColorStop(0.4, 'rgba(214, 255, 63, 0.035)');
      glow.addColorStop(1, 'rgba(214, 255, 63, 0)');
      surface.fillStyle = glow;
      surface.fillRect(currentX - radius, currentY - radius, radius * 2, radius * 2);

      warpSurface.clearRect(0, 0, width, height);
      warpSurface.globalCompositeOperation = 'source-over';
      warpSurface.strokeStyle = 'rgba(242, 240, 233, 0.52)';
      warpSurface.lineWidth = 1;

      const startX = Math.floor(minX / grid) * grid;
      for (let x = startX; x <= maxX; x += grid) {
        const points: { x: number; y: number }[] = [];
        for (let y = minY; y <= maxY; y += sampleStep) {
          points.push(warp(x, y, radius, strength));
        }
        strokeLine(warpSurface, points);
      }

      const startY = Math.floor(minY / grid) * grid;
      for (let y = startY; y <= maxY; y += grid) {
        const points: { x: number; y: number }[] = [];
        for (let x = minX; x <= maxX; x += sampleStep) {
          points.push(warp(x, y, radius, strength));
        }
        strokeLine(warpSurface, points);
      }

      const mask = warpSurface.createRadialGradient(
        currentX,
        currentY,
        radius * 0.1,
        currentX,
        currentY,
        radius
      );
      mask.addColorStop(0, 'rgba(0, 0, 0, 1)');
      mask.addColorStop(0.72, 'rgba(0, 0, 0, 0.9)');
      mask.addColorStop(1, 'rgba(0, 0, 0, 0)');
      warpSurface.globalCompositeOperation = 'destination-in';
      warpSurface.fillStyle = mask;
      warpSurface.fillRect(0, 0, width, height);
      warpSurface.globalCompositeOperation = 'source-over';

      surface.globalCompositeOperation = 'lighter';
      surface.drawImage(warpCanvas, 0, 0, width, height);

      const ring = 72 + energy * 12;
      const spin = now * 0.0006;

      surface.lineWidth = 1;
      surface.strokeStyle = 'rgba(214, 255, 63, 0.2)';
      surface.beginPath();
      surface.arc(currentX, currentY, ring, 0, Math.PI * 2);
      surface.stroke();

      surface.lineWidth = 1.5;
      surface.strokeStyle = 'rgba(214, 255, 63, 0.8)';
      surface.beginPath();
      surface.arc(currentX, currentY, ring, spin, spin + 1.15);
      surface.stroke();

      surface.lineWidth = 1;
      surface.strokeStyle = 'rgba(242, 240, 233, 0.55)';
      surface.beginPath();
      surface.moveTo(currentX - 8, currentY);
      surface.lineTo(currentX - 3, currentY);
      surface.moveTo(currentX + 3, currentY);
      surface.lineTo(currentX + 8, currentY);
      surface.moveTo(currentX, currentY - 8);
      surface.lineTo(currentX, currentY - 3);
      surface.moveTo(currentX, currentY + 3);
      surface.lineTo(currentX, currentY + 8);
      surface.stroke();

      surface.fillStyle = 'rgba(214, 255, 63, 0.9)';
      surface.beginPath();
      surface.arc(currentX, currentY, 1.6, 0, Math.PI * 2);
      surface.fill();

      surface.globalCompositeOperation = 'source-over';
    }

    function frame(now: number) {
      const dt = lastFrame ? Math.min(34, now - lastFrame) : 16.667;
      lastFrame = now;
      const step = dt / 16.667;

      if (!active) {
        running = false;
        lastFrame = 0;
        return;
      }

      currentX += (targetX - currentX) * Math.min(1, 0.16 * step);
      currentY += (targetY - currentY) * Math.min(1, 0.16 * step);
      energy += (energyTarget - energy) * Math.min(1, 0.12 * step);
      energyTarget *= Math.pow(0.9, step);

      draw(now);
      requestAnimationFrame(frame);
    }

    const onEnter = (event: PointerEvent) => {
      if (event.pointerType === 'touch') return;
      active = true;
      hero.classList.add('is-field');
      const point = pointFrom(event);
      targetX = currentX = point.x;
      targetY = currentY = point.y;
      energy = 0;
      energyTarget = 0;
      start();
    };

    const onMove = (event: PointerEvent) => {
      if (event.pointerType === 'touch') return;
      if (!active) {
        const point = pointFrom(event);
        targetX = currentX = point.x;
        targetY = currentY = point.y;
        energy = 0;
        energyTarget = 0;
        active = true;
        hero.classList.add('is-field');
        start();
        return;
      }

      const point = pointFrom(event);
      const dx = point.x - targetX;
      const dy = point.y - targetY;
      energyTarget = clamp(Math.hypot(dx, dy) / 26, 0, 1);
      targetX = point.x;
      targetY = point.y;
      start();
    };

    const onLeave = (event: PointerEvent) => {
      if (event.pointerType === 'touch') return;
      active = false;
      hero.classList.remove('is-field');
    };

    resize();
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(resize).observe(sticky);
    } else {
      window.addEventListener('resize', resize);
    }

    stickyEl.addEventListener('pointerenter', onEnter);
    stickyEl.addEventListener('pointermove', onMove, { passive: true });
    stickyEl.addEventListener('pointerleave', onLeave);
  })();
</script>
