---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Intro from '../../components/Intro.astro';
import Projects from '../../components/Projects.astro';
import Stack from '../../components/Stack.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { localizePath, useTranslations } from '../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const nav = [
  { href: '#intro', label: t('nav.profile') },
  { href: '#work', label: t('nav.work') },
  { href: '#stack', label: t('nav.stack') },
  { href: '#contact', label: t('nav.contact') },
];
---

<BaseLayout lang={lang} title={t('site.title')} description={t('site.description')}>
  <Header
    lang={lang}
    homeHref={localizePath('en', '/')}
    switchHref={localizePath('es', '/')}
    switchLabel="ES"
    nav={nav}
    available={t('header.available')}
    menuLabel={t('nav.menu')}
    closeLabel={t('nav.close')}
  />

  <main id="main">
    <Hero
      eyebrow={t('hero.eyebrow')}
      location={t('hero.location')}
      role={t('hero.role')}
      tagline={t('hero.tagline')}
      scroll={t('hero.scroll')}
      asideTop={t('hero.asideTop')}
      asideBottom={t('hero.asideBottom')}
    />

    <Intro
      label={t('intro.label')}
      statementA={t('intro.statementA')}
      statementB={t('intro.statementB')}
      body={t('intro.body')}
      listTitle={t('intro.listTitle')}
      items={[t('intro.item1'), t('intro.item2'), t('intro.item3'), t('intro.item4'), t('intro.item5')]}
      stats={[t('intro.stat1'), t('intro.stat2'), t('intro.stat3')]}
      location={t('hero.location')}
      photoAlt={t('intro.photoAlt')}
      photoCaption={t('intro.photoCaption')}
    />

    <Projects lang={lang} />

    <Stack lang={lang} />

    <Contact lang={lang} />
  </main>

  <Footer lang={lang} nav={nav} />
</BaseLayout>
